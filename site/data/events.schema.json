{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competition Department public event data",
  "type": "object",
  "required": ["schemaVersion", "activeAcademicYear", "lastReviewed", "eventSeries", "editions", "calendar", "notices", "recruitment"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "activeAcademicYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" },
    "lastReviewed": { "type": ["string", "null"], "format": "date" },
    "eventSeries": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/eventSeries" } },
    "editions": { "type": "array", "items": { "$ref": "#/$defs/edition" } },
    "calendar": { "type": "array", "items": { "$ref": "#/$defs/calendarItem" } },
    "notices": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "recruitment": { "$ref": "#/$defs/recruitment" }
  },
  "$defs": {
    "eventSeries": { "type": "object", "required": ["id", "name", "shortName", "sequence", "summary", "audience", "detailPath"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "shortName": { "$ref": "#/$defs/text" }, "sequence": { "type": "string", "pattern": "^[0-9]{2}$" }, "summary": { "$ref": "#/$defs/text" }, "audience": { "$ref": "#/$defs/text" }, "detailPath": { "$ref": "#/$defs/text" } }, "additionalProperties": false },
    "edition": { "type": "object", "required": ["id", "seriesId", "academicYear", "title", "status", "startDate", "endDate", "location", "audience", "rulesUrl", "registrationUrl", "archiveUrl", "sources", "lastReviewed"], "properties": { "id": { "$ref": "#/$defs/id" }, "seriesId": { "$ref": "#/$defs/id" }, "academicYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" }, "title": { "$ref": "#/$defs/text" }, "status": { "enum": ["preview", "registration", "upcoming", "finished"] }, "startDate": { "$ref": "#/$defs/nullableDate" }, "endDate": { "$ref": "#/$defs/nullableDate" }, "location": { "$ref": "#/$defs/nullableText" }, "audience": { "$ref": "#/$defs/nullableText" }, "rulesUrl": { "$ref": "#/$defs/nullableText" }, "registrationUrl": { "$ref": "#/$defs/nullableText" }, "archiveUrl": { "$ref": "#/$defs/nullableText" }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }, "lastReviewed": { "type": "string", "format": "date" } }, "additionalProperties": false },
    "calendarItem": { "type": "object", "required": ["id", "editionId", "date", "label", "location", "url"], "properties": { "id": { "$ref": "#/$defs/id" }, "editionId": { "$ref": "#/$defs/id" }, "date": { "type": "string", "format": "date" }, "label": { "$ref": "#/$defs/text" }, "location": { "$ref": "#/$defs/nullableText" }, "url": { "$ref": "#/$defs/nullableText" } }, "additionalProperties": false },
    "notice": { "type": "object", "required": ["id", "date", "title", "url", "source", "lastReviewed"], "properties": { "id": { "$ref": "#/$defs/id" }, "date": { "type": "string", "format": "date" }, "title": { "$ref": "#/$defs/text" }, "url": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/source" }, "lastReviewed": { "type": "string", "format": "date" } }, "additionalProperties": false },
    "recruitment": { "type": "object", "required": ["status", "label", "url"], "properties": { "status": { "enum": ["open", "closed", "pending-confirmation"] }, "label": { "$ref": "#/$defs/text" }, "url": { "$ref": "#/$defs/nullableText" } }, "additionalProperties": false },
    "source": { "type": "object", "required": ["label", "url"], "properties": { "label": { "$ref": "#/$defs/text" }, "url": { "$ref": "#/$defs/text" } }, "additionalProperties": false },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "text": { "type": "string", "minLength": 1 },
    "nullableText": { "type": ["string", "null"] },
    "nullableDate": { "type": ["string", "null"], "format": "date" }
  },
  "additionalProperties": false
}
